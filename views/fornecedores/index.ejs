<%- include('../partials/header') %>
    <%- include('../partials/nav') %>


        <div class="container mt-5">

            <div class="d-flex justify-content-between
                align-items-center mb-4">

                <div>

                    <h1>Fornecedores</h1>

                    <p class="text-muted">
                        Lista de Fornecedores cadastrados
                    </p>

                </div>

                <a href="/fornecedores/cadastro" class="btn btn-dark">

                    + Novo Fornecedores

                </a>

            </div>


            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-hover
                              align-middle">

                            <thead class="table-dark">

                                <tr>
                                    <th>ID</th>
                                    <th>Razão Social</th>
                                    <th>CNPJ</th>
                                    <th>Email</th>
                                     <th>Telephone</th>
                                      <th>Cidade</th>
                                      <th>Opções</th>

                                </tr>

                            </thead>

                            <tbody>
                                    <% fornecedores.forEach(mostrar =>  { %>

                                <tr>
                                    <td><%= mostrar.id %></td>

                                    <td><%= mostrar.rasaoSocial %></td>

                                    <td><%= mostrar.cnpj %></td>

                                    <td><%= mostrar.email %></td>

                                    <td><%= mostrar.telephone %></td>

                                    <td><%= mostrar.cidade %></td>

                                     <td>
                                            <a class="btn btn-warning btn-sm"
                                                href="/fornecedores/editar/<%= mostrar.id %>">Editar</a>

                                            <a class="btn btn-danger btn-sm"
                                                href="/fornecedores/excluir/<%= mostrar.id %>"
                                                onclick="return confirm('Deseja excluir este Cliente?')">Excluir</a>

                                        </td>

                                </tr>
                            

                            <% })%>
                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>
        <%- include('../partials/footer') %>